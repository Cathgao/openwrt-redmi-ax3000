#!/bin/sh /etc/rc.common

START=99

tune_network() {
	# 1. Wait for ath11k debugfs nodes up to 30 seconds
	for i in $(seq 1 30); do
		if ls /sys/kernel/debug/ath11k/*/stats_disable >/dev/null 2>&1; then
			break
		fi
		sleep 1
	done

	# 2. Enable ath11k Fast-RX & Fast-TX by bypassing debug stats
	for d in /sys/kernel/debug/ath11k/*/stats_disable; do
		[ -f "$d" ] && echo 1 > "$d"
	done

	# 3. Lock REO hardware hash to Ring 1 (FIFO serialization) to prevent packet reordering
	for h in /sys/kernel/debug/ath11k/*/rx_hash; do
		[ -f "$h" ] && echo '11111111' > "$h"
	done

	# 4. SMP IRQ affinity pipelining:
	# Keep all Wi-Fi RX REO rings on CPU 0 (mask 1) for strict sequence ordering
	for irq in $(awk -F: '/reo2host/{print $1}' /proc/interrupts | tr -d ' '); do
		echo 1 > /proc/irq/$irq/smp_affinity 2>/dev/null
	done

	# Offload NSS completions and Wi-Fi Tx ACK completions to CPU 1 (mask 2)
	for irq in $(awk -F: '/nss_queue|wbm2host/{print $1}' /proc/interrupts | tr -d ' '); do
		echo 2 > /proc/irq/$irq/smp_affinity 2>/dev/null
	done

	# 5. Tune socket buffers and backlog for multi-stream throughput
	sysctl -w net.core.netdev_max_backlog=10000 >/dev/null 2>&1
	sysctl -w net.core.rmem_max=4194304 >/dev/null 2>&1
	sysctl -w net.core.wmem_max=4194304 >/dev/null 2>&1
	sysctl -w net.ipv4.tcp_rmem="4096 87380 4194304" >/dev/null 2>&1
	sysctl -w net.ipv4.tcp_wmem="4096 65536 4194304" >/dev/null 2>&1

	# 6. Set CPU frequency governor to performance
	for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
		[ -f "$g" ] && echo performance > "$g" 2>/dev/null
	done
}

start() {
	tune_network &
}

boot() {
	tune_network &
}
